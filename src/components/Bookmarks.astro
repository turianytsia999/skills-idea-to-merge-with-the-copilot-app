---
// Markup renders during the static build. All browser-only behavior
// (localStorage, DOM events) lives in the client <script> below, which Astro
// bundles for the browser and never runs during the build.
---
<form id="add-bookmark" novalidate>
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      aria-describedby="form-error"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p id="form-error" class="error" role="alert" hidden></p>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  import {
    STORAGE_KEY,
    SEPARATOR,
    normalizeUrl,
    uniqueSlug,
    parseStored,
    serialize,
    type Bookmark,
  } from '../lib/bookmarks';

  const form = document.getElementById('add-bookmark') as HTMLFormElement | null;
  const input = document.getElementById('url') as HTMLInputElement | null;
  const errorEl = document.getElementById('form-error');
  const list = document.getElementById('bookmark-list');
  const empty = document.getElementById('empty-state');
  const header = document.getElementById('list-header');
  const clearBtn = document.getElementById('clear-all');

  let bookmarks: Bookmark[] = [];

  function load(): Bookmark[] {
    try {
      return parseStored(localStorage.getItem(STORAGE_KEY));
    } catch {
      return [];
    }
  }

  function save(): void {
    try {
      localStorage.setItem(STORAGE_KEY, serialize(bookmarks));
    } catch {
      // Storage unavailable or full: keep working in memory.
    }
  }

  function showError(message: string): void {
    if (!errorEl) return;
    errorEl.textContent = message;
    errorEl.hidden = !message;
  }

  function render(): void {
    if (!list) return;
    list.replaceChildren();
    for (const b of bookmarks) {
      const li = document.createElement('li');
      li.className = 'bookmark';

      const a = document.createElement('a');
      a.className = 'url';
      a.href = b.url;
      a.target = '_blank';
      a.rel = 'noopener noreferrer';
      a.textContent = b.url;

      const sep = document.createElement('span');
      sep.className = 'sep';
      sep.textContent = SEPARATOR;

      const slug = document.createElement('span');
      slug.className = 'slug';
      slug.textContent = b.slug;

      const copy = document.createElement('button');
      copy.type = 'button';
      copy.className = 'copy';
      copy.textContent = 'Copy';
      copy.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(b.slug);
          copy.textContent = 'Copied!';
          setTimeout(() => (copy.textContent = 'Copy'), 1200);
        } catch {
          copy.textContent = 'Copy failed';
        }
      });

      li.append(a, sep, slug, copy);
      list.append(li);
    }
    if (empty) empty.hidden = bookmarks.length > 0;
    if (header) header.hidden = bookmarks.length === 0;
  }

  form?.addEventListener('submit', (event) => {
    event.preventDefault(); // first, so no error can fall back to a native submit
    try {
      const url = normalizeUrl(input?.value);
      if (!url) {
        showError('Enter a valid web address, like example.com.');
        return;
      }
      showError('');
      if (bookmarks.some((b) => b.url === url)) {
        showError('That link is already saved.');
        return;
      }
      bookmarks = [{ url, slug: uniqueSlug(bookmarks) }, ...bookmarks];
      save();
      render();
      if (input) input.value = '';
      input?.focus();
    } catch {
      showError('Something went wrong. Please try again.');
    }
  });

  clearBtn?.addEventListener('click', () => {
    try {
      if (!confirm('Remove all saved bookmarks?')) return;
      bookmarks = [];
      try {
        localStorage.removeItem(STORAGE_KEY);
      } catch {
        // ignore
      }
      render();
    } catch {
      // ignore
    }
  });

  try {
    bookmarks = load();
    render();
  } catch {
    bookmarks = [];
  }
</script>
